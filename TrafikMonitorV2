:local interface "sfp-sfpplus1-DBN"
:local targetGateway "192.168.1.50"
:delay 5
:local traffic [/interface monitor-traffic $interface once as-value]
:local rx ($traffic->"rx-bits-per-second")
:local tx ($traffic->"tx-bits-per-second")

# Hitung dalam bps, ubah ke Mbps (dibagi 1000000)
:local rxMbps (($rx - 0) / 1000000)
:local txMbps (($tx - 0) / 1000000)

:log info "Traffic $interface -> RX: $rxMbps Mbps, TX: $txMbps Mbps"

:if ($rxMbps <=100) do={
/system logging disable 0
:delay 1

/ip route disable [find comment="DBN"]
/routing rule disable [find comment="DBN"]
:delay 1

/ip firewall connection
:foreach i in=[find where (src-address~"192.168\\.24\\." or src-address~"192.168\\.25\\.") and reply-dst-address~$targetGateway] do={
    remove $i
    }

:delay 1
/system logging enable 0
} else={
#:log info "Trafik $interface Aman "
}
